{
	"name": "totorobot",
	"version": "3.0.0",
	"description": "Experimental type-safe finite state machines with per-state context",
	"license": "BlueOak-1.0.0",
	"author": "Quentin Roy <quentin@quentinroy.fr>",
	"keywords": [
		"finite-state-machine",
		"fsm",
		"state-machine",
		"typestate",
		"typescript",
		"type-safe",
		"state"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/totorobot.d.ts",
			"default": "./dist/totorobot.js"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"start": "node examples/index.ts",
		"dev": "node --watch examples/index.ts",
		"examples": "node examples/index.ts",
		"build": "vite build",
		"prepack": "pnpm build",
		"size": "pnpm build && node scripts/size.ts",
		"version": "changeset version && node scripts/size-changelog.ts && pnpm format",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:types": "vitest run --typecheck.only",
		"test:coverage": "vitest run --coverage",
		"test:dist": "pnpm build && vitest run --config vitest.dist.config.ts && node scripts/check-declaration-emit.ts",
		"typecheck": "tsc --noEmit",
		"typecheck:candidates": "node scripts/check-candidates.ts",
		"measure:completions": "node scripts/measure-completions.mjs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/QuentinRoy/totorobot.git"
	},
	"homepage": "https://github.com/QuentinRoy/totorobot#readme",
	"bugs": {
		"url": "https://github.com/QuentinRoy/totorobot/issues"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.1",
		"@types/node": "^26.4.0",
		"@typescript/typescript6": "^6.0.2",
		"@vitest/coverage-v8": "^4.1.11",
		"prettier": "^3.9.6",
		"robot3": "^1.2.0",
		"terser": "^5.51.2",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vite-plugin-dts": "^5.1.0",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@11.24.0"
}
